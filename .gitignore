# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/

# ---- TruckSim native history and other large binary artifacts ---------------
# Regenerated by every run; the JSON manifests that describe them are kept.
*.vs
*.vsb
*.vsrap
*.erd
*.avi
*.mp4
# The recorded 3D traverse video is a deliverable, not a regenerated artefact.
!runs/**/video/*.mp4
*_all.par
*_echo.par
*_end.par
*_log.txt
output/

# ---- Per-run evidence ------------------------------------------------------
# Keep every manifest / report / summary (small, and they are the evidence),
# drop the bulky per-sample CSV and packaged datasets.
runs/**/data/*.csv
runs/**/*.csv
runs/batch_*/
runs/_unit_probe/
runs/_actuator_gain/probe_model/
!runs/**/*.json
!runs/**/*.md

# ---- Investigation scratch -------------------------------------------------
scratch_video_probe/

# ---- Generated models ------------------------------------------------------
# run_all.par / simfile.sim / manifests are kept: they are small and make the
# study reproducible. The merged TruckSim parameter dumps above are not.

# ---- Generated replay images ------------------------------------------------
*.png
