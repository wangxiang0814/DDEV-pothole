# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/

# ---- TruckSim native history and other large binary artifacts ---------------
# All local runs are generated data. Portable evidence lives under evidence/.
runs/
*.vs
*.vsb
*.vsrap
*.erd
*.avi
*.mp4
*_all.par
!models/**/run_all.par
!evidence/**/run_all.par
*_echo.par
*_end.par
*_log.txt
output/

# ---- Investigation scratch -------------------------------------------------
scratch_video_probe/
.superpowers/
docs/plans/

# ---- Local scratch, IDE and machine-specific files -------------------------
# tmp/ holds run logs, throwaway plots and a machine-local TruckSim licence
# registry export; .idea/ is the local IDE project. Neither belongs in the repo.
tmp/
.idea/
*.reg

# ---- Generated replay images; curated figure is evidence --------------------
*.png
!evidence/**/*.png
